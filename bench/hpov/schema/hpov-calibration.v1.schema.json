{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forcefield.local/hpov/schema/hpov-calibration.v1.schema.json",
  "title": "hpov.calibration v1",
  "description": "An HPOV A/A calibration campaign: one binary measured as both subjects, repeated, every trial decided by the ordinary comparison. Readers must ignore unknown fields; minor additions do not bump major. The trials are the evidence; summary and conclusion are a reading of them and may be recomputed from the trials.",
  "type": "object",
  "required": ["schema", "schema_version", "kind", "method_version", "subjects", "plan", "thresholds", "comparison", "trials", "summary", "conclusion"],
  "properties": {
    "schema": { "const": "hpov.calibration" },
    "schema_version": { "type": "string", "pattern": "^1\\." },
    "kind": { "const": "aa" },
    "method_version": { "type": "string" },
    "suite": {
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "definition_set": { "type": "string" }
      }
    },
    "subjects": {
      "type": "object",
      "description": "The A/A identity. One binary, two labels.",
      "required": ["base_label", "head_label", "path", "sha256", "identical_trials", "identical_in_every_trial"],
      "properties": {
        "base_label": { "type": "string" },
        "head_label": { "type": "string" },
        "path": { "type": "string" },
        "sha256": { "type": "string" },
        "size_bytes": { "type": "integer" },
        "version": { "type": "string" },
        "source": { "type": "string" },
        "identical_trials": { "type": "integer" },
        "identical_in_every_trial": { "type": "boolean" }
      }
    },
    "plan": {
      "type": "object",
      "required": ["benchmarks", "profile", "repeats", "seed_base", "seeds"],
      "properties": {
        "benchmarks": { "type": "array", "items": { "type": "string" } },
        "profile": { "type": "string" },
        "repeats": { "type": "integer" },
        "warmup_override": { "type": "integer" },
        "n_override": { "type": "integer" },
        "seed_base": { "type": "integer" },
        "seeds": { "type": "array", "items": { "type": "integer" } }
      }
    },
    "thresholds": {
      "type": "object",
      "description": "The table every trial decided against, by identity rather than by value.",
      "required": ["version", "source"],
      "properties": {
        "version": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "comparison": {
      "type": "object",
      "required": ["schema_version", "method_version", "family_alpha", "paired"],
      "properties": {
        "schema_version": { "type": "string" },
        "method_version": { "type": "string" },
        "family_alpha": { "type": "number", "exclusiveMinimum": 0 },
        "paired": { "type": "boolean" }
      }
    },
    "host": {
      "type": "object",
      "properties": {
        "os": { "type": "string" },
        "arch": { "type": "string" },
        "cpu_model": { "type": "string" },
        "logical_cpus": { "type": "integer" },
        "clock_source": { "type": "string" },
        "clock_resolution_ns": { "type": "integer" },
        "power_source": { "type": "string" },
        "power_plan": { "type": "string" },
        "host_id": { "type": "string" },
        "host_ids": { "type": "array", "items": { "type": "string" } },
        "single_host": { "type": "boolean" }
      }
    },
    "trials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "seed", "run_id", "result_path", "comparison_path", "quality", "quality_rejected", "identical_subjects", "subject_hashes", "metrics"],
        "properties": {
          "index": { "type": "integer" },
          "seed": { "type": "integer" },
          "run_id": { "type": "string" },
          "result_path": { "type": "string" },
          "comparison_path": { "type": "string" },
          "quality": {
            "type": "object",
            "required": ["label"],
            "properties": {
              "label": { "enum": ["good", "degraded", "poor"] },
              "flags": { "type": "array", "items": { "type": "string" } }
            }
          },
          "quality_rejected": { "type": "boolean" },
          "benchmark_errors": { "type": "boolean" },
          "identical_subjects": { "type": "boolean" },
          "subject_hashes": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2,
            "maxItems": 2
          },
          "metrics": { "type": "array", "items": { "$ref": "#/$defs/metricSample" } },
          "coverage": { "type": "array", "items": { "$ref": "#/$defs/coverage" } }
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "Counts by verdict name with explicit denominators. No score.",
      "required": ["trials", "decisions", "eligible_decisions", "verdict_counts", "false_positives", "false_improvements", "per_metric"],
      "properties": {
        "trials": { "type": "integer" },
        "trials_quality_good": { "type": "integer" },
        "trials_quality_degraded": { "type": "integer" },
        "trials_quality_rejected": { "type": "integer" },
        "trials_with_benchmark_errors": { "type": "integer" },
        "decisions": { "type": "integer" },
        "quality_rejected_decisions": { "type": "integer" },
        "eligible_decisions": { "type": "integer" },
        "verdict_counts": { "type": "object", "additionalProperties": { "type": "integer" } },
        "withheld_reasons": { "type": "object", "additionalProperties": { "type": "integer" } },
        "false_positives": { "$ref": "#/$defs/falseChanges" },
        "false_improvements": { "$ref": "#/$defs/falseChanges" },
        "per_metric": { "type": "array", "items": { "$ref": "#/$defs/metricSummary" } }
      }
    },
    "conclusion": {
      "type": "string",
      "description": "What the campaign does and does not license, stored so a copied-out report keeps its caveat."
    }
  },
  "$defs": {
    "interval": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "metricSample": {
      "type": "object",
      "description": "One metric decision from one trial, with the evidence that produced it.",
      "required": ["benchmark", "name", "unit", "verdict", "baseline_n", "candidate_n", "base_p50", "cur_p50", "abs_delta", "ci_excludes_zero", "holm_adjusted", "threshold_pct", "threshold_abs", "threshold_used_bytes", "threshold_met", "noise_flagged"],
      "properties": {
        "benchmark": { "type": "string" },
        "name": { "type": "string" },
        "unit": { "type": "string" },
        "verdict": { "type": "string" },
        "verdict_reason": { "type": "string" },
        "baseline_n": { "type": "integer" },
        "candidate_n": { "type": "integer" },
        "base_p50": { "type": "number" },
        "cur_p50": { "type": "number" },
        "base_p95": { "type": ["number", "null"] },
        "cur_p95": { "type": ["number", "null"] },
        "abs_delta": { "type": "number" },
        "rel_delta_pct": { "type": ["number", "null"] },
        "ci95_median_diff": { "$ref": "#/$defs/interval" },
        "ci_excludes_zero": { "type": "boolean" },
        "ci_excludes_zero_p95": { "type": "boolean" },
        "mann_whitney_p_raw": { "type": ["number", "null"] },
        "mann_whitney_p_adjusted": { "type": ["number", "null"] },
        "holm_rank": { "type": "integer" },
        "holm_adjusted": { "type": "boolean" },
        "threshold_pct": { "type": "number" },
        "threshold_abs": { "type": "number" },
        "threshold_used_bytes": { "type": "number" },
        "threshold_met": { "type": "boolean" },
        "noise_flagged": { "type": "boolean" },
        "noise_flags": { "type": "array", "items": { "type": "string" } },
        "baseline_quality": { "type": "string" },
        "candidate_quality": { "type": "string" }
      }
    },
    "metricSummary": {
      "type": "object",
      "required": ["benchmark", "name", "unit", "decisions", "eligible_decisions", "verdict_counts"],
      "properties": {
        "benchmark": { "type": "string" },
        "name": { "type": "string" },
        "unit": { "type": "string" },
        "threshold_pct": { "type": "number" },
        "threshold_abs": { "type": "number" },
        "decisions": { "type": "integer" },
        "quality_rejected_decisions": { "type": "integer" },
        "eligible_decisions": { "type": "integer" },
        "verdict_counts": { "type": "object", "additionalProperties": { "type": "integer" } },
        "withheld_reasons": { "type": "object", "additionalProperties": { "type": "integer" } },
        "noise_flagged_trials": { "type": "integer" },
        "threshold_met_trials": { "type": "integer" },
        "ci_excludes_zero_trials": { "type": "integer" },
        "raw_p_below_alpha_trials": { "type": "integer" },
        "holm_survived_trials": { "type": "integer" },
        "tail_evidence_trials": { "type": "integer" },
        "median_abs_rel_delta_pct": { "type": ["number", "null"] },
        "max_abs_rel_delta_pct": { "type": ["number", "null"] },
        "median_baseline_n": { "type": "integer" },
        "median_candidate_n": { "type": "integer" },
        "movement_over_threshold_trials": { "type": "integer" }
      }
    },
    "falseChanges": {
      "type": "object",
      "description": "Claims the comparison made about a subject against itself, with the denominator attached.",
      "required": ["total", "denominator"],
      "properties": {
        "regressed": { "type": "integer" },
        "tail_regressed": { "type": "integer" },
        "improved": { "type": "integer" },
        "tail_improved": { "type": "integer" },
        "total": { "type": "integer" },
        "denominator": { "type": "integer" },
        "rate": { "type": ["number", "null"] },
        "definition": { "type": "string" }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["benchmark", "reason"],
      "properties": {
        "benchmark": { "type": "string" },
        "name": { "type": "string" },
        "reason": { "enum": ["unsupported", "skipped", "removed", "new", "missing", "invalid"] }
      }
    }
  }
}
