{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forcefield.local/hpov/schema/hpov-compare.v1.schema.json",
  "title": "hpov.compare v1",
  "description": "Comparison of two hpov.result documents. Readers must ignore unknown fields; minor additions do not bump major. Verdicts are decided per metric: there is no aggregate score.",
  "type": "object",
  "required": ["schema", "schema_version", "method_version", "inputs", "options", "method", "summary", "metrics"],
  "properties": {
    "schema": { "const": "hpov.compare" },
    "schema_version": { "type": "string", "pattern": "^1\\." },
    "method_version": { "type": "string" },
    "inputs": {
      "type": "object",
      "required": ["baseline", "candidate"],
      "properties": {
        "baseline": { "$ref": "#/$defs/side" },
        "candidate": { "$ref": "#/$defs/side" }
      }
    },
    "options": {
      "type": "object",
      "required": ["allow_cross_host", "fail_on_regression", "explain"],
      "properties": {
        "allow_cross_host": { "type": "boolean" },
        "fail_on_regression": { "type": "boolean" },
        "explain": { "type": "boolean" }
      }
    },
    "method": {
      "type": "object",
      "required": ["family_alpha", "holm_correction", "statistical_evidence", "effect_estimate", "noise_multiplier", "threshold_source", "threshold_version"],
      "properties": {
        "family_alpha": { "type": "number", "exclusiveMinimum": 0 },
        "holm_correction": { "const": true },
        "statistical_evidence": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
        "effect_estimate": { "type": "string" },
        "bootstrap_resamples": { "type": "integer" },
        "bootstrap_seed": { "type": "integer" },
        "noise_multiplier": { "type": "number" },
        "directional_only": { "type": "boolean" },
        "threshold_source": { "type": "string" },
        "threshold_version": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["counts", "regressed_metrics", "reported_metrics"],
      "properties": {
        "counts": { "type": "object", "additionalProperties": { "type": "integer" } },
        "regressed_metrics": { "type": "integer" },
        "reported_metrics": { "type": "integer" }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["benchmark", "name", "unit", "direction", "verdict", "baseline_n", "candidate_n", "base_p50", "cur_p50", "abs_delta", "signed", "mann_whitney_p", "threshold_pct", "threshold_abs", "threshold_met", "ci_excludes_zero", "holm_adjusted"],
        "properties": {
          "benchmark": { "type": "string" },
          "name": { "type": "string" },
          "unit": { "type": "string" },
          "direction": { "type": "string" },
          "platform_semantics": { "type": "string" },
          "verdict": { "$ref": "#/$defs/verdict" },
          "verdict_reason": { "type": "string" },
          "baseline_n": { "type": "integer" },
          "candidate_n": { "type": "integer" },
          "base_p50": { "type": "number" },
          "cur_p50": { "type": "number" },
          "base_p95": { "type": ["number", "null"] },
          "cur_p95": { "type": ["number", "null"] },
          "abs_delta": { "type": "number" },
          "rel_delta_pct": { "type": ["number", "null"] },
          "signed": { "type": "number" },
          "signed_rel_pct": { "type": ["number", "null"] },
          "hodges_lehmann_shift": { "type": "number" },
          "ci95_median_diff": { "$ref": "#/$defs/interval" },
          "ci_excludes_zero": { "type": "boolean" },
          "ci95_p95_diff": { "$ref": "#/$defs/interval" },
          "ci_excludes_zero_p95": { "type": "boolean" },
          "mann_whitney_p": { "type": ["number", "null"] },
          "mann_whitney_p_raw": { "type": ["number", "null"] },
          "holm_adjusted": { "type": "boolean" },
          "holm_rank": { "type": "integer" },
          "threshold_pct": { "type": "number" },
          "threshold_abs": { "type": "number" },
          "threshold_effective_bytes": { "type": "number" },
          "threshold_used_bytes": { "type": "number" },
          "threshold_met": { "type": "boolean" },
          "noise_flagged": { "type": "boolean" },
          "noise_flags": { "type": "array", "items": { "type": "string" } },
          "baseline_quality": { "type": "string" },
          "candidate_quality": { "type": "string" },
          "confounded_build": { "type": "boolean" }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["benchmark", "reason"],
        "properties": {
          "benchmark": { "type": "string" },
          "name": { "type": "string" },
          "reason": { "enum": ["unsupported", "skipped", "removed", "new", "missing", "invalid"] }
        }
      }
    },
    "trade_offs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["benchmark", "improved", "regressed", "explanation"],
        "properties": {
          "benchmark": { "type": "string" },
          "improved": { "type": "array", "items": { "type": "string" } },
          "regressed": { "type": "array", "items": { "type": "string" } },
          "explanation": { "type": "string" }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "verdict": {
      "enum": [
        "improved",
        "regressed",
        "unchanged",
        "tail_regressed",
        "tail_improved",
        "inconclusive",
        "missing_base",
        "missing_current",
        "incompatible",
        "not_comparable",
        "invalid",
        "informational"
      ]
    },
    "interval": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "side": {
      "type": "object",
      "required": ["role"],
      "properties": {
        "role": { "enum": ["baseline", "candidate"] },
        "path": { "type": "string" },
        "run_id": { "type": "string" },
        "suite_version": { "type": "string" },
        "profile": { "type": "string" },
        "quality": { "type": "string" },
        "host_id": { "type": "string" },
        "os": { "type": "string" },
        "arch": { "type": "string" },
        "from_same_file": { "type": "boolean" },
        "subject": { "type": "string" }
      }
    }
  }
}
