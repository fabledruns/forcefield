# Forcefield environment variables — copy to .env and fill in real values.
# Never commit real credentials. See docs/Config.md#secrets.
# Resolution order: process environment → ./.env → ~/.forcefield/.env

# NVIDIA NIM (https://integrate.api.nvidia.com)
NVIDIA_API_KEY=your_api_key_here

# OpenAI (https://api.openai.com)
OPENAI_API_KEY=your_api_key_here

# Anthropic (https://api.anthropic.com)
ANTHROPIC_API_KEY=your_api_key_here

# Google Gemini (https://generativelanguage.googleapis.com)
GEMINI_API_KEY=your_api_key_here

# xAI (https://api.x.ai)
XAI_API_KEY=your_api_key_here

# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=your_api_key_here

# Groq (https://api.groq.com)
GROQ_API_KEY=your_api_key_here

# Mistral (https://api.mistral.ai)
MISTRAL_API_KEY=your_api_key_here

# Together AI (https://api.together.xyz)
TOGETHER_API_KEY=your_api_key_here
